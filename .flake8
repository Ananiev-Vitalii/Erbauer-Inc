[flake8]
select = E,F,W,C90,ANN,Q0
max-line-length = 88
max-complexity = 18
inline-quotes = "

extend-ignore =
    E203,
    E701,
    W503,
    ANN002,
    ANN003,
    ANN101,
    ANN102,
    ANN401

extend-exclude =
    .venv,
    venv,
    migrations,
    staticfiles,
    media

per-file-ignores =
    config/settings/dev.py:F403,F405
    config/settings/prod.py:F403,F405
