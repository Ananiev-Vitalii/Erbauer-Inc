# =========================
# Django
# =========================
# Settings module to load (prod/dev/base.)
DJANGO_SETTINGS_MODULE=config.settings.base
# Django debug mode: True for local development only, False in production
DJANGO_DEBUG=True
# Secret key used by Django; keep it private and never commit a real production value
DJANGO_SECRET_KEY=your_secret_key

# =========================
# Email
# =========================
BREVO_API_KEY=your_brevo_api_key
DEFAULT_FROM_EMAIL='Company_name <example@gmail.com>'
COMPANY_CONTACT_EMAIL=example@gmail.com
SIMPLE_INVOICE_RECIPIENT_EMAIL=company@example.com

# ============================
# Cloudflare Turnstile captcha
# ============================
CF_TURNSTILE_SITE_KEY=your_cf_turnstile_site_key
CF_TURNSTILE_SECRET_KEY=your_cf_turnstile_secret_key

# =========================
# DB cache on the home page
# =========================
CACHE_DEFAULT_TIMEOUT=900

# =========================
# Postgres DB
# =========================
POSTGRES_DB=your_db_name
POSTGRES_DB_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=your_db_host

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# Rate limits
# =========================

# Contact form rate limit
CONTACT_FORM_ATTEMPTS=10
CONTACT_FORM_WINDOW=120
CONTACT_FORM_COOLDOWN=600

# Resend verification rate limit
VERIFICATION_ATTEMPTS = 10
VERIFICATION_WINDOW = 120
VERIFICATION_COOLDOWN = 600

# Password reset rate limit
PASSWORD_RESET_ATTEMPTS = 10
PASSWORD_RESET_WINDOW = 120
PASSWORD_RESET_COOLDOWN = 600

# Registration rate limit
REGISTRATION_ATTEMPTS=10
REGISTRATION_WINDOW=120
REGISTRATION_COOLDOWN=600

# Login rate limit
LOGIN_ATTEMPTS = 10
LOGIN_WINDOW = 120
LOGIN_COOLDOWN = 600